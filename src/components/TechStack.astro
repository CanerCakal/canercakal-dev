---
import * as si from "simple-icons";

// slug: simple-icons anahtarı (siSwift → "siSwift"). Yoksa monogram gösterilir.
const items = [
  { name: "Swift", slug: "siSwift" },
  { name: "SwiftUI", slug: "siSwift" },
  { name: "SwiftData", slug: "siSwift" },
  { name: "Xcode", slug: "siXcode" },
  { name: "Firebase", slug: "siFirebase" },
  { name: "Python", slug: "siPython" },
  { name: "scikit-learn", slug: "siScikitlearn" },
  { name: "pandas", slug: "siPandas" },
  { name: "TypeScript", slug: "siTypescript" },
  { name: "React", slug: "siReact" },
  { name: "Astro", slug: "siAstro" },
  { name: "FastAPI", slug: "siFastapi" },
  { name: "PostgreSQL", slug: "siPostgresql" },
  { name: "Docker", slug: "siDocker" },
  { name: "Unity", slug: "siUnity" },
  { name: "C#", slug: "siCsharp" },
  { name: "Git", slug: "siGit" },
  { name: "GitHub", slug: "siGithub" },
  { name: "Cloudflare", slug: "siCloudflare" },
  { name: "Figma", slug: "siFigma" },
];

type Icon = { path: string; hex: string };

const resolved = items.map((item) => {
  const icon = item.slug ? ((si as any)[item.slug] as Icon | undefined) : undefined;
  return {
    name: item.name,
    path: icon?.path ?? null,
    hex: icon ? `#${icon.hex}` : null,
  };
});
---

<section class="stack" aria-label="Kullandığım teknolojiler" data-reveal>
  <div class="marquee">
    <ul class="marquee-track">
      {
        [0, 1].map((copy) => (
          <li aria-hidden={copy === 1}>
            {resolved.map((t) => (
              <span class="chip" style={t.hex ? `--brand: ${t.hex}` : ""}>
                {t.path ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d={t.path} />
                  </svg>
                ) : (
                  <span class="dot" aria-hidden="true" />
                )}
                {t.name}
              </span>
            ))}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .stack {
    margin: var(--space-5) 0 var(--space-6);
  }

  .marquee {
    overflow: hidden;
    padding: var(--space-2) 0;
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    list-style: none;
    margin: 0;
    padding: 0;
    animation: scroll 48s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-track li {
    display: flex;
    gap: var(--space-3);
    padding-right: var(--space-3);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 18px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 1px solid var(--card-border);
    box-shadow: var(--shadow-sm);
    font-family: var(--font-mono);
    font-size: 0.83rem;
    color: var(--text);
    white-space: nowrap;
    transition:
      transform var(--t-base) var(--ease-spring),
      box-shadow var(--t-base) var(--ease-out),
      border-color var(--t-base) var(--ease-out);
  }

  .chip:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: color-mix(in srgb, var(--brand, var(--accent)) 40%, transparent);
  }

  .chip svg {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    fill: var(--brand, var(--text-muted));
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
    }
    .chip:hover {
      transform: none;
    }
  }
</style>