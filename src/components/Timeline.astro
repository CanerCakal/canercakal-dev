---
import { community } from "../data/community";

const MONTHS = [
	"Oca",
	"Şub",
	"Mar",
	"Nis",
	"May",
	"Haz",
	"Tem",
	"Ağu",
	"Eyl",
	"Eki",
	"Kas",
	"Ara",
];

const parse = (v: string) => v.split("-").map(Number) as [number, number];

const label = (start: string, end?: string) => {
	const [sy, sm] = parse(start);
	if (!end) return `${MONTHS[sm - 1]} ${sy} → bugün`;
	const [ey, em] = parse(end);
	return sy === ey
		? `${MONTHS[sm - 1]} – ${MONTHS[em - 1]} ${sy}`
		: `${MONTHS[sm - 1]} ${sy} – ${MONTHS[em - 1]} ${ey}`;
};

const months = (a: string, b: string) => {
	const [ay, am] = parse(a);
	const [by, bm] = parse(b);
	return Math.abs((ay - by) * 12 + (am - bm));
};

// Boşluk = bir sonraki kayda kalan süre, sıkıştırılmış orantı
const items = community.map((e, i) => {
	const next = community[i + 1];
	const gap = next
		? Math.min(Math.max(months(e.start, next.start) * 16, 40), 160)
		: 0;
	return { ...e, when: label(e.start, e.end), gap };
});
---

<section class="community" aria-label="Topluluk ve liderlik">
	<section class="community bleed" aria-label="Topluluk ve liderlik">
	</section>
	<h2>Topluluk</h2>
	<ol class="tl" data-line>
		{
			items.map((e, i) => (
				<li
					class:list={["item", { ongoing: !e.end }]}
					style={`--gap: ${e.gap}px; --reveal-delay: ${i * 110}ms`}
					data-reveal
				>
					<div class="entry">
						<span class="when">{e.when}</span>
						<h3>{e.role}</h3>
						<span class="org">{e.org}</span>
						{e.text && <p>{e.text}</p>}
					</div>
				</li>
			))
		}
	</ol>
</section>

<style>
	.community {
		margin-top: var(--space-6);
	}
	.community h2 {
		font-size: 1.125rem;
		text-align: center;
		margin-bottom: var(--space-5);
	}

	.tl {
		position: relative;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.tl::before {
		content: "";
		position: absolute;
		left: 50%;
		top: 0.5rem;
		bottom: 0.5rem;
		width: 1px;
		transform: translateX(-50%) scaleY(0);
		transform-origin: top;
		transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
		background: linear-gradient(
			to bottom,
			var(--accent),
			color-mix(in srgb, var(--accent) 10%, transparent)
		);
	}
	.tl.is-visible::before {
		transform: translateX(-50%) scaleY(1);
	}

	.item {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: var(--space-5);
		margin-bottom: var(--gap);
	}
	.item::before {
		content: "";
		position: absolute;
		left: 50%;
		top: 0.55rem;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		transform: translateX(-50%);
		background: var(--bg);
		border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
	}
	.item.ongoing::before {
		background: var(--accent);
		border-color: var(--accent);
		box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 50%, transparent);
	}

	.item:nth-child(odd) .entry {
		grid-column: 1;
		text-align: right;
	}
	.item:nth-child(even) .entry {
		grid-column: 2;
		text-align: left;
	}

	.when {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		color: var(--text-muted);
	}
	.ongoing .when {
		color: var(--accent);
	}
	.item h3 {
		font-size: 0.9375rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		margin: 2px 0 0;
	}
	.org {
		display: block;
		font-size: 0.8125rem;
		color: var(--text-muted);
		line-height: 1.5;
	}
	.item p {
		font-size: 0.875rem;
		color: color-mix(in srgb, var(--text) 70%, transparent);
		line-height: 1.6;
		margin: var(--space-2) 0 0;
	}

	@media (max-width: 760px) {
		.community h2 {
			text-align: left;
		}
		.tl {
			padding-left: var(--space-4);
		}
		.tl::before {
			left: 4px;
			transform: scaleY(0);
		}
		.tl.is-visible::before {
			transform: scaleY(1);
		}
		.item {
			grid-template-columns: 1fr;
		}
		.item::before {
			left: calc(var(--space-4) * -1 + 4px);
			transform: translateX(-50%);
		}
		.item:nth-child(odd) .entry,
		.item:nth-child(even) .entry {
			grid-column: 1;
			text-align: left;
		}
		.item {
			margin-bottom: calc(var(--gap) * 0.6);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.tl::before,
		.tl.is-visible::before {
			transform: translateX(-50%) scaleY(1);
			transition: none;
		}
	}
</style>