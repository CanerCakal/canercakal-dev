---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchRepo } from "../../lib/github";
import { Image } from "astro:assets";

const entries = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

const accents = ["var(--accent)", "var(--accent-2)", "var(--accent-3)"];

const projects = await Promise.all(
  entries.map(async (entry, i) => ({
    ...entry.data,
    id: entry.id,
    accent: accents[i % 3],
    live: await fetchRepo(entry.data.repo),
  })),
);

const formatDate = (iso: string) => new Date(iso).toLocaleDateString("tr-TR");
---

<BaseLayout title="Projeler — Caner Çakal">
  <h1>Projeler<span class="dot"></span></h1>
  <p class="lead">Yaptıklarım — canlı veriler doğrudan GitHub'dan geliyor.</p>

  <div class="grid">
    {
      projects.map((p) => (
        <div class="row" style={"--item: " + p.accent}>
          <a class="card" href={"/projects/" + p.id}>
            <div class="card-top">
              <h2>{p.title}</h2>
              {p.live && p.live.stars > 0 && (
                <span class="stars">★ {p.live.stars}</span>
              )}
            </div>
            <p class="summary">{p.summary}</p>
            <div class="meta">
              {p.live?.language && <span class="lang">{p.live.language}</span>}
              {p.tags
                .filter(
                  (t) =>
                    t.toLowerCase() !== (p.live?.language ?? "").toLowerCase(),
                )
                .map((t) => (
                  <span class="tag">{t}</span>
                ))}
            </div>
            {p.preview && (
              <Image
                class="inline-shot"
                src={p.preview}
                alt={p.title + " ekran görüntüsü"}
                width={480}
                loading="lazy"
              />
            )}
          </a>
          {p.preview && (
            <div class="preview" aria-hidden="true">
              <Image src={p.preview} alt="" width={560} loading="lazy" />
            </div>
          )}
        </div>
      ))
    }
  </div>
</BaseLayout>

<style>
  .dot {
    color: var(--accent-2);
  }
  .lead {
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }
  .grid {
    display: grid;
    gap: var(--space-3);
  }
  .row {
    position: relative;
  }
  .card {
    display: block;
    padding: var(--space-4);
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: var(--radius-lg);
    color: var(--text);
    transition:
      border-color 0.25s var(--ease-spring),
      transform 0.25s var(--ease-spring);
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--item) 45%, transparent);
    box-shadow: 0 0 30px color-mix(in srgb, var(--item) 14%, transparent);
    transform: translateY(-3px);
    opacity: 1;
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
  }
  .card h2 {
    font-size: 1.0625rem;
    margin: 0;
  }
  .stars {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }
  .summary {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin: var(--space-2) 0 var(--space-3);
  }
  .meta {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .lang,
  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 2px 10px;
    border-radius: 999px;
  }
  .lang {
    background: color-mix(in srgb, var(--item) 13%, transparent);
    color: var(--item);
  }
  .tag {
    border: 1px solid var(--border);
    color: var(--text-muted);
  }
  /* --- Hover preview (geniş ekran) --- */
  .preview {
    position: absolute;
    top: 50%;
    left: 100%;
    margin-left: -40px;
    width: 280px;
    padding: 6px;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--bg) 65%, transparent);
    border: 1px solid color-mix(in srgb, var(--item) 30%, transparent);
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.55),
      0 0 40px color-mix(in srgb, var(--item) 12%, transparent);
    backdrop-filter: blur(20px) saturate(1.2);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    opacity: 0;
    pointer-events: none;
    z-index: 5;
    transform: translateY(-50%) translateX(10px) scale(0.97);
    transition:
      opacity 0.28s ease,
      transform 0.4s var(--ease-spring);
  }
  .preview :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
  }
  .card:hover + .preview,
  .card:focus-visible + .preview {
    opacity: 1;
    transform: translateY(-50%) translateX(0) scale(1);
  }

  /* --- Karta gömülü görsel (dar ekran) --- */
  .inline-shot {
    display: none;
    width: 100%;
    max-width: 240px;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--card-border);
    margin-top: var(--space-3);
  }

  @media (max-width: 1200px) {
    .preview {
      display: none;
    }
    .inline-shot {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preview,
    .card:hover + .preview,
    .card:focus-visible + .preview {
      transform: translateY(-50%);
      transition: opacity 0.2s ease;
    }
  }
</style>
