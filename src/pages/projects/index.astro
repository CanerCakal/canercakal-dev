---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchRepo } from "../../lib/github";
import { Image } from "astro:assets";

const entries = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

const accents = ["var(--accent)", "var(--accent-2)", "var(--accent-3)"];

const projects = await Promise.all(
  entries.map(async (entry, i) => ({
    ...entry.data,
    id: entry.id,
    accent: accents[i % 3],
    live: await fetchRepo(entry.data.repo),
  })),
);

const formatDate = (iso: string) => new Date(iso).toLocaleDateString("tr-TR");
---

<BaseLayout
  title="Projeler — Caner Çakal"
  description="Yaptığım iOS uygulamaları, veri bilimi ve oyun projeleri — her biri için neden ve nasıl."
>
  <h1 data-reveal>Projeler<span class="dot"></span></h1>
  <p class="lead" data-reveal style="--reveal-delay: 80ms">
    GitHub'dan gelen verilerle birlikte çalışmalarım. Repo'ya uğrayarak bir iz
    bırakabilir veya projeyi indirip deneyebilirsiniz.
  </p>
  <div class="grid">
    {
      projects.map((p, i) => (
        <div
          class="row"
          style={`--item: ${p.accent}; --reveal-delay: ${Math.min(i, 5) * 70 + 160}ms`}
          data-reveal
          data-row
        >
          <a class="card" href={"/projects/" + p.id}>
            <div class="card-top">
              <h2>{p.title}</h2>
              {p.live && p.live.stars > 0 && (
                <span class="stars">★ {p.live.stars}</span>
              )}
            </div>
            <p class="summary">{p.summary}</p>
            <div class="meta">
              {p.live?.language && <span class="lang">{p.live.language}</span>}
              {p.tags
                .filter((t) => {
                  const lang = (p.live?.language ?? "").toLowerCase();
                  if (!lang) return true;
                  const tag = t.toLowerCase();
                  // "Swift" ile "Swift 6" aynı sayılsın
                  return tag !== lang && !tag.startsWith(lang + " ");
                })
                .map((t) => (
                  <span class="tag">{t}</span>
                ))}
            </div>
            {p.preview && (
              <Image
                class="inline-shot"
                src={p.preview}
                alt={p.title + " ekran görüntüsü"}
                width={480}
                loading="lazy"
              />
            )}
          </a>
          {p.preview && (
            <div class="preview" data-preview aria-hidden="true">
              <Image src={p.preview} alt="" width={560} loading="lazy" />
            </div>
          )}
        </div>
      ))
    }
  </div>
</BaseLayout>

<style>
  .dot {
    color: var(--accent-2);
  }
  .lead {
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }
  .grid {
    display: grid;
    gap: var(--space-3);
  }
  .row {
    position: relative;
  }
  .card {
    position: relative;
    display: block;
    overflow: hidden;
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--card-border);
    box-shadow: var(--shadow-sm);
    border-radius: var(--radius-xl);
    color: var(--text);
    transition:
      border-color var(--t-base) var(--ease-out),
      box-shadow var(--t-base) var(--ease-out),
      transform var(--t-base) var(--ease-spring);
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--item) 32%, transparent);
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
    opacity: 1;
  }
  .card:hover::before {
    opacity: 1;
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
  }
  .card h2 {
    font-size: 1.0625rem;
    margin: 0;
  }
  .stars {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }
  .summary {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin: var(--space-2) 0 var(--space-3);
  }
  .meta {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .lang,
  .tag {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
  }
  .lang {
    background: color-mix(in srgb, var(--item) 11%, transparent);
    border: 1px solid color-mix(in srgb, var(--item) 24%, transparent);
    color: var(--item);
  }
  .tag {
    border: 1px solid var(--card-border);
    background: var(--bg);
    color: var(--text-muted);
  }
  /* --- İmleci takip eden önizleme --- */
  .preview {
    position: absolute;
    top: 0;
    left: 0;
    width: 300px;
    padding: 7px;
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--item) 28%, transparent);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    pointer-events: none;
    z-index: 5;
    transform: translate(var(--px, 0px), var(--py, 0px))
      rotate(var(--tilt, 0deg)) scale(0.94);
    transform-origin: 20% 20%;
    transition:
      opacity 0.22s ease,
      scale 0.32s var(--ease-spring);
  }
  .row.showing .preview {
    opacity: 1;
    transform: translate(var(--px, 0px), var(--py, 0px))
      rotate(var(--tilt, 0deg)) scale(1);
  }
  .preview :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 13px;
  }

  /* --- Karta gömülü görsel (dokunmatik / dar ekran) --- */
  .inline-shot {
    display: none;
    width: 100%;
    max-width: 260px;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--card-border);
    margin-top: var(--space-3);
  }

  @media (max-width: 1100px), (pointer: coarse) {
    .preview {
      display: none;
    }
    .inline-shot {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
    .preview {
      display: none;
    }
    .inline-shot {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preview,
    .card:hover + .preview,
    .card:focus-visible + .preview {
      transform: translateY(-50%);
      transition: opacity 0.2s ease;
    }
  }
</style>
<script>
  const rows = Array.from(document.querySelectorAll<HTMLElement>("[data-row]"));
  const fine = window.matchMedia("(pointer: fine)").matches;
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (fine && !calm) {
    rows.forEach((row) => {
      const preview = row.querySelector<HTMLElement>("[data-preview]");
      if (!preview) return;

      let tx = 0,
        ty = 0; // hedef
      let cx = 0,
        cy = 0; // mevcut
      let raf: number | null = null;
      let active = false;

      const OFFSET_X = 26; // imlecin sağına
      const OFFSET_Y = -40; // biraz yukarı

      const loop = () => {
        cx += (tx - cx) * 0.14;
        cy += (ty - cy) * 0.14;

        // Yatay hıza göre hafif eğim
        const tilt = Math.max(-7, Math.min(7, (tx - cx) * 0.09));

        preview.style.setProperty("--px", `${cx.toFixed(1)}px`);
        preview.style.setProperty("--py", `${cy.toFixed(1)}px`);
        preview.style.setProperty("--tilt", `${tilt.toFixed(2)}deg`);

        if (active || Math.abs(tx - cx) > 0.4 || Math.abs(ty - cy) > 0.4) {
          raf = requestAnimationFrame(loop);
        } else {
          raf = null;
        }
      };

      const move = (e: PointerEvent) => {
        const rect = row.getBoundingClientRect();
        tx = e.clientX - rect.left + OFFSET_X;
        ty = e.clientY - rect.top + OFFSET_Y;
        if (raf === null) raf = requestAnimationFrame(loop);
      };

      row.addEventListener("pointerenter", (e: PointerEvent) => {
        active = true;
        const rect = row.getBoundingClientRect();
        // Girişte zıplamasın: mevcut konumu imlecin yanına yerleştir
        cx = tx = e.clientX - rect.left + OFFSET_X;
        cy = ty = e.clientY - rect.top + OFFSET_Y;
        preview.style.setProperty("--px", `${cx}px`);
        preview.style.setProperty("--py", `${cy}px`);
        row.classList.add("showing");
        if (raf === null) raf = requestAnimationFrame(loop);
      });

      row.addEventListener("pointermove", move);

      row.addEventListener("pointerleave", () => {
        active = false;
        row.classList.remove("showing");
      });
    });
  }
</script>