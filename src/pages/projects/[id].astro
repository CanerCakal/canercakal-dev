---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchRepo } from "../../lib/github";

export async function getStaticPaths() {
    const entries = await getCollection("projects");
    return entries.map((entry) => ({
        params: { id: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const live = await fetchRepo(entry.data.repo);
const hasBody = (entry.body ?? "").trim().length > 0;

const updated = live
    ? new Date(live.pushedAt).toLocaleDateString("tr-TR", {
          day: "numeric",
          month: "long",
          year: "numeric",
      })
    : null;
---

<BaseLayout
    title={entry.data.title + " — Caner Çakal"}
    description={entry.data.summary}
>
    <a class="back" href="/projects">← Projeler</a>

    <article>
        <header class="head">
            <h1 class="gradient-text">{entry.data.title}</h1>
            <p class="lead">{entry.data.summary}</p>

            <div class="meta">
                {
                    live?.language && (
                        <span class="pill lang">{live.language}</span>
                    )
                }
                {entry.data.tags.map((t) => <span class="pill">{t}</span>)}
            </div>

            <div class="row">
                <a
                    class="repo-btn"
                    href={"https://github.com/" + entry.data.repo}
                    target="_blank"
                    rel="noopener"
                >
                    Kaynak kodu — GitHub {
                        live && live.stars > 0 ? "★ " + live.stars : ""
                    }
                </a>
                {updated && <span class="updated">son commit: {updated}</span>}
            </div>
        </header>

        {
            hasBody ? (
                <div class="prose">
                    <Content />
                </div>
            ) : (
                <p class="soon">
                    Bu projenin detaylı hikayesi yolda — şimdilik kaynak koda
                    göz atabilirsin.
                </p>
            )
        }
    </article>
</BaseLayout>

<style>
    .back {
        font-family: var(--font-mono);
        font-size: 0.875rem;
        color: var(--text-muted);
    }
    .back:hover {
        color: var(--accent);
        opacity: 1;
    }

    .head {
        margin: var(--space-4) 0 var(--space-5);
    }
    .head h1 {
        font-size: 1.75rem;
        margin: 0 0 var(--space-2);
        width: fit-content;
    }
    .lead {
        color: var(--text-muted);
        font-size: 1.0625rem;
        max-width: 38rem;
    }
    .meta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin: var(--space-3) 0;
    }
    .pill {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        border: 1px solid var(--card-border);
        color: var(--text-muted);
        padding: 2px 10px;
        border-radius: 999px;
    }
    .pill.lang {
        background: var(--accent-subtle);
        color: var(--accent);
        border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    }
    .row {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        flex-wrap: wrap;
    }
    .repo-btn {
        font-family: var(--font-mono);
        font-size: 0.875rem;
        color: var(--text);
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        padding: 8px 18px;
        border-radius: var(--radius);
        transition:
            border-color 0.25s ease,
            box-shadow 0.25s ease;
    }
    .repo-btn:hover {
        border-color: color-mix(in srgb, var(--accent) 50%, transparent);
        box-shadow: 0 0 24px color-mix(in srgb, var(--accent) 14%, transparent);
        opacity: 1;
    }
    .updated {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-muted);
    }
    .soon {
        color: var(--text-muted);
        border: 1px dashed var(--card-border);
        border-radius: var(--radius);
        padding: var(--space-4);
    }
</style>

<style is:global>
    .prose h2 {
        font-size: 1.25rem;
        margin: var(--space-5) 0 var(--space-3);
    }
    .prose h3 {
        font-size: 1.0625rem;
        margin: var(--space-4) 0 var(--space-2);
    }
    .prose p {
        line-height: 1.8;
        margin: 0 0 var(--space-3);
    }
    .prose ul,
    .prose ol {
        padding-left: 1.25rem;
        margin: 0 0 var(--space-3);
    }
    .prose li {
        margin-bottom: var(--space-1);
    }
    .prose code {
        font-family: var(--font-mono);
        font-size: 0.85em;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        padding: 1px 6px;
        border-radius: 6px;
    }
    .prose pre {
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid var(--card-border);
        border-radius: var(--radius);
        padding: var(--space-3);
        overflow-x: auto;
    }
    .prose pre code {
        background: none;
        border: none;
        padding: 0;
    }
    .prose img {
        max-width: 100%;
        border-radius: var(--radius);
        border: 1px solid var(--card-border);
    }
    .prose blockquote {
        border-left: 3px solid var(--accent-2);
        margin: 0 0 var(--space-3);
        padding-left: var(--space-3);
        color: var(--text-muted);
    }
</style>
