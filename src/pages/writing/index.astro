---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchArticles } from "../../lib/medium";

const articles = await fetchArticles();
const accents = ["var(--accent)", "var(--accent-2)", "var(--accent-3)"];

const formatDate = (d: Date) =>
	d.toLocaleDateString("tr-TR", {
		day: "numeric",
		month: "long",
		year: "numeric",
	});
---

<BaseLayout
	title="Yazılar — Caner Çakal"
	description="Öğrendiklerim ve verdiğim kararlar üzerine yazdıklarım."
>
	<h1 data-reveal>Yazılar<span class="dot"></span></h1>
	<p class="lead" data-reveal style="--reveal-delay: 80ms">
		Öğrendiklerimi ve verdiğim kararları yazıya döküyorum. Hepsi ve daha
		fazlası Medium'da.
	</p>

	{
		articles.length === 0 ? (
			<p class="empty">
				Yazılar şu an yüklenemedi —
				<a
					href="https://medium.com/@canercakalofficial"
					target="_blank"
					rel="noopener"
				>
					Medium profilimden
				</a>
				okuyabilirsin.
			</p>
		) : (
			<ol class="list">
				{articles.map((a, i) => (
					<li
						style={`--item: ${accents[i % 3]}; --reveal-delay: ${Math.min(i, 5) * 70 + 160}ms`}
						data-reveal
					>
						<a
							class="article"
							href={a.url}
							target="_blank"
							rel="noopener"
						>
							<span class="num">
								{String(i + 1).padStart(2, "0")}
							</span>
							<span class="body">
								<span class="top">
									<h2>{a.title}</h2>
									<time>{formatDate(a.date)}</time>
								</span>
								<p class="excerpt">{a.excerpt}</p>
								<span class="meta">
									{a.tags.map((t) => (
										<span class="tag">{t}</span>
									))}
									<span class="go">
										Medium'da oku
										<svg
											viewBox="0 0 24 24"
											aria-hidden="true"
										>
											<path d="M7 17 17 7M9 7h8v8" />
										</svg>
									</span>
								</span>
							</span>
						</a>
					</li>
				))}
			</ol>
		)
	}
</BaseLayout>

<style>
	.dot {
		color: var(--accent-3);
	}
	.lead {
		color: var(--text-muted);
		margin-bottom: var(--space-5);
	}
	.empty {
		color: var(--text-muted);
	}

	.list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--border);
	}
	.list li {
		border-bottom: 1px solid var(--border);
	}

	.article {
		display: grid;
		grid-template-columns: 3rem 1fr;
		gap: var(--space-3);
		padding: var(--space-4) var(--space-3);
		color: var(--text);
		transition:
			background var(--t-base) var(--ease-out),
			padding-left var(--t-base) var(--ease-out);
	}
	.article:hover {
		background: color-mix(in srgb, var(--item) 5%, transparent);
		padding-left: var(--space-5);
		opacity: 1;
	}

	.num {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text-muted);
		padding-top: 4px;
		transition: color var(--t-base) var(--ease-out);
	}
	.article:hover .num {
		color: var(--item);
	}

	.body {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.top {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4);
	}
	.article h2 {
		font-size: 1.05rem;
		margin: 0;
		transition: color var(--t-base) var(--ease-out);
	}
	.article:hover h2 {
		color: var(--item);
	}
	.top time {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--text-muted);
		white-space: nowrap;
		flex-shrink: 0;
	}

	.excerpt {
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.7;
		margin: var(--space-2) 0 var(--space-3);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.tag {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		border: 1px solid var(--card-border);
		background: var(--surface);
		color: var(--text-muted);
		padding: 3px 11px;
		border-radius: var(--radius-pill);
	}
	.go {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: 0.76rem;
		color: var(--item);
		opacity: 0;
		transform: translateX(-6px);
		transition:
			opacity var(--t-base) var(--ease-out),
			transform var(--t-base) var(--ease-out);
	}
	.article:hover .go,
	.article:focus-visible .go {
		opacity: 1;
		transform: translateX(0);
	}
	.go svg {
		width: 13px;
		height: 13px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	@media (max-width: 640px) {
		.article {
			grid-template-columns: 2.2rem 1fr;
		}
		.top {
			flex-direction: column;
			gap: 4px;
		}
		.go {
			opacity: 1;
			transform: none;
			margin-left: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.article:hover {
			padding-left: var(--space-3);
		}
		.go {
			transition: none;
		}
	}
</style>