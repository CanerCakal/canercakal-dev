---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { DOMAIN_LABELS, type Domain } from "../lib/domains";
import Timeline from "../components/Timeline.astro";
import Work from "../components/Work.astro";
import Events from "../components/Events.astro";
import Hero from "../components/Hero.astro";
import TechStack from "../components/TechStack.astro";

const accents = ["var(--accent)", "var(--accent-2)", "var(--accent-3)"];

const featured = (await getCollection("projects"))
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 3)
	.map((p, i) => ({
		title: p.data.title,
		text: p.data.summary,
		href: `https://github.com/${p.data.repo}`,
		accent: accents[i],
		domain: p.data.domain,
	}));

const now = [
	{
		label: "Yapıyorum",
		text: "Bu site dahil, aklımdaki fikirleri gerçek projelere dönüştürüyorum",
		accent: "var(--accent)",
		icon: "M12 3 3 9v12h6v-6h6v6h6V9z",
	},
	{
		label: "Odaklanıyorum",
		text: "Swift ve iOS tarafında derinleşiyorum — MVVM mimari, modern API'ler, temiz ve okunabilir kod",
		accent: "var(--accent-2)",
		icon: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z",
	},
	{
		label: "Yazıyorum",
		text: "Süreç sonunda öğrendiklerimi ve verdiğim kararları düzenli olarak yazıya döküyorum",
		accent: "var(--accent-3)",
		icon: "M4 20h4L18.5 9.5a2.12 2.12 0 0 0-3-3L5 17v3z",
	},
];
---

<BaseLayout title="Caner Çakal">
	<section class="hero">
		<Hero />
	</section>

	<TechStack />

	<section class="now">
		<h2><span class="pulse" aria-hidden="true"></span>Şu sıralar</h2>
		<ul>
			{
				now.map(({ label, text, accent, icon }, i) => (
					<li
						style={`--item: ${accent}; --reveal-delay: ${i * 90}ms`}
						data-reveal
					>
						<span class="now-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24">
								<path d={icon} />
							</svg>
						</span>
						<h3 class="now-label">{label}</h3>
						<p class="now-text">{text}</p>
					</li>
				))
			}
		</ul>
	</section>

	<Work />

	<section class="featured" aria-label="Öne çıkanlar" data-reveal>
		<h2>Öne çıkanlar</h2>
		<div class="stage" id="stage">
			{
				featured.map((f, i) => (
					<a
						class={`fcard pos-${i}`}
						href={f.href}
						target="_blank"
						rel="noopener"
						style={`--item: ${f.accent}`}
						data-card
					>
						{f.domain && (
							<span class="domain">
								{DOMAIN_LABELS[f.domain]}
							</span>
						)}
						<h3>{f.title}</h3>
						<p>{f.text}</p>
					</a>
				))
			}
		</div>
	</section>

	<Timeline />
	<Events />
</BaseLayout>

<style>
	.hero {
		margin-bottom: var(--space-6);
	}

	.now h2 {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: 1.125rem;
		margin-bottom: var(--space-3);
	}
	.pulse {
		position: relative;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--accent);
	}
	.pulse::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: var(--accent);
		animation: pulse 2.4s ease-out infinite;
	}
	@keyframes pulse {
		0% {
			transform: scale(1);
			opacity: 0.45;
		}
		70% {
			transform: scale(3.4);
			opacity: 0;
		}
		100% {
			transform: scale(3.4);
			opacity: 0;
		}
	}
	.now ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-3);
	}
	.now li {
		position: relative;
		overflow: hidden;
		padding: var(--space-4);
		background: var(--surface);
		border: 1px solid var(--card-border);
		box-shadow: var(--shadow-sm);
		border-radius: var(--radius-lg);
		transition:
			border-color var(--t-base) var(--ease-out),
			box-shadow var(--t-base) var(--ease-out),
			transform var(--t-base) var(--ease-spring);
	}
	.now li::before {
		content: "";
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0;
		background: radial-gradient(
			240px circle at var(--mx, 50%) var(--my, 50%),
			color-mix(in srgb, var(--item) 18%, transparent),
			transparent 66%
		);
		transition: opacity var(--t-base) var(--ease-out);
	}
	.now li:hover::before {
		opacity: 1;
	}
	.now li > * {
		position: relative;
		z-index: 1;
	}
	.now li:hover {
		border-color: color-mix(in srgb, var(--item) 35%, transparent);
		box-shadow: var(--shadow-md);
		transform: translateY(-3px);
	}
	.now-icon {
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		margin-bottom: var(--space-3);
		border-radius: var(--radius);
		background: color-mix(in srgb, var(--item) 10%, transparent);
		border: 1px solid color-mix(in srgb, var(--item) 22%, transparent);
	}
	.now-icon svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: var(--item);
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.now-label {
		font-family: var(--font-mono);
		font-size: 0.95rem;
		color: var(--text);
		margin: 0 0 var(--space-2);
	}
	.now-text {
		color: var(--text-muted);
		font-size: 0.9rem;
		line-height: 1.65;
		margin: 0;
	}
	@media (max-width: 780px) {
		.now ul {
			grid-template-columns: 1fr;
		}
	}
	.updated {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
		margin-top: var(--space-3);
	}

	@media (prefers-reduced-motion: reduce) {
		.pulse::after {
			animation: none;
			opacity: 0;
		}
	}

	.featured {
		margin-top: var(--space-6);
		margin-bottom: var(--space-6);
	}
	.featured h2 {
		font-size: 1.125rem;
		margin-bottom: var(--space-4);
	}
	.stage {
		position: relative;
		height: 15rem;
		perspective: 1200px;
	}
	.fcard {
		position: absolute;
		inset: 0;
		margin: auto;
		max-width: 26rem;
		height: fit-content;
		padding: var(--space-4);
		border-radius: var(--radius-lg);
		background: var(--surface);
		border: 1px solid var(--card-border);
		color: var(--text);
		will-change: transform, opacity;
		transition:
			transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.7s ease,
			border-color 0.3s ease,
			box-shadow 0.3s ease;
	}
	.fcard .domain {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--text-muted);
		letter-spacing: 0.02em;
	}
	.fcard h3 {
		font-size: 1.0625rem;
		margin: var(--space-2) 0;
	}
	.fcard p {
		font-size: 0.875rem;
		color: var(--text-muted);
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.pos-0 {
		transform: translateZ(0);
		z-index: 3;
		border-color: color-mix(in srgb, var(--item) 35%, transparent);
		box-shadow: var(--shadow-lg);
	}
	.pos-1 {
		transform: translateX(-40%) translateZ(-160px) rotateY(14deg)
			scale(0.94);
		z-index: 2;
		opacity: 0.88;
		box-shadow: var(--shadow-sm);
	}
	.pos-2 {
		transform: translateX(40%) translateZ(-160px) rotateY(-14deg)
			scale(0.94);
		z-index: 1;
		opacity: 0.88;
		box-shadow: var(--shadow-sm);
	}
	@media (max-width: 640px) {
		.stage {
			height: 17rem;
		}
		.fcard {
			max-width: calc(100vw - 4rem);
		}
		.pos-1 {
			transform: translateY(-9%) translateZ(-150px) scale(0.92);
		}
		.pos-2 {
			transform: translateY(9%) translateZ(-150px) scale(0.92);
		}
	}
</style>

<script>
	const stage = document.getElementById("stage");
	const cards = Array.from(document.querySelectorAll("[data-card]"));
	const reducedMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;

	if (stage && cards.length > 1 && !reducedMotion) {
		let offset = 0;
		const n = cards.length;

		const apply = () => {
			cards.forEach((card, i) => {
				card.className = card.className.replace(
					/pos-\d/,
					`pos-${(i - offset + n) % n}`,
				);
			});
		};

		let timer = setInterval(() => {
			offset = (offset + 1) % n;
			apply();
		}, 4500);

		// Hover'da dur — kullanıcı okuyorsa sahne bekler
		stage.addEventListener("mouseenter", () => clearInterval(timer));
		stage.addEventListener("mouseleave", () => {
			timer = setInterval(() => {
				offset = (offset + 1) % n;
				apply();
			}, 4500);
		});

		// Arkadaki karta tıklanınca: linke gitme, öne gel
		cards.forEach((card, i) => {
			card.addEventListener("click", (e) => {
				if (!card.classList.contains("pos-0")) {
					e.preventDefault();
					offset = i;
					apply();
				}
			});
		});
	}
</script>
<script>
	const list = document.querySelector<HTMLElement>(".now ul");
	const reducedSpot = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;

	if (list && !reducedSpot) {
		list.addEventListener("pointermove", (e: PointerEvent) => {
			const target = (e.target as HTMLElement).closest("li");
			if (!target) return;
			const rect = target.getBoundingClientRect();
			target.style.setProperty("--mx", `${e.clientX - rect.left}px`);
			target.style.setProperty("--my", `${e.clientY - rect.top}px`);
		});
	}
</script>