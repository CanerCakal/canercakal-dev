---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { fetchArticles } from "../lib/medium";
import { DOMAIN_LABELS, type Domain } from "../lib/domains";
import Timeline from "../components/Timeline.astro";
import Work from "../components/Work.astro";
import Events from "../components/Events.astro";

const featuredProjects = (await getCollection("projects"))
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 2);

const articles = await fetchArticles();
const latestArticle = articles[0] ?? null;

type FeaturedCard = {
	kind: string;
	title: string;
	text: string;
	href: string;
	accent: string;
	domain?: Domain;
};

const featured: FeaturedCard[] = [
	{
		kind: "proje",
		title: featuredProjects[0]?.data.title ?? "",
		text: featuredProjects[0]?.data.summary ?? "",
		href: `https://github.com/${featuredProjects[0]?.data.repo ?? ""}`,
		accent: "var(--accent)",
		domain: featuredProjects[0]?.data.domain,
	},
	...(latestArticle
		? [
				{
					kind: "yazı",
					title: latestArticle.title,
					text: latestArticle.excerpt,
					href: latestArticle.url,
					accent: "var(--accent-2)",
				},
			]
		: []),
	{
		kind: "proje",
		title: featuredProjects[1]?.data.title ?? "",
		text: featuredProjects[1]?.data.summary ?? "",
		href: `https://github.com/${featuredProjects[1]?.data.repo ?? ""}`,
		accent: "var(--accent-3)",
		domain: featuredProjects[1]?.data.domain,
	},
].filter((f) => f.title);

const now = [
	{
		label: "Yapıyorum",
		text: "Bu site dahil, aklımdaki fikirleri gerçek projelere dönüştürüyorum",
		accent: "var(--accent)",
	},
	{
		label: "Odaklanıyorum",
		text: "Swift ve iOS tarafında derinleşiyorum — mimari, modern API'ler, iyi kod",
		accent: "var(--accent-2)",
	},
	{
		label: "Yazıyorum",
		text: "Öğrendiklerimi ve verdiğim kararları düzenli olarak yazıya döküyorum",
		accent: "var(--accent-3)",
	},
];
---

<BaseLayout title="Caner Çakal">
	<section class="hero">
		<h1>
			Merhaba, ben <span class="gradient-text">Caner</span><span
				class="cursor">_</span
			>
		</h1>
		<p class="intro" id="intro">
			Bilgisayar mühendisliği öğrencisiyim ancak bekleyen cinsten değilim:
			yapıyorum, bozuyorum, tekrar yapıyorum ve sonunda yazıya döküyorum.
			Bu aralar sürekli aynı şeylerle uğraşıyorum - herkesin cebinde olan
			cihazlarla...
		</p>
	</section>

	<section class="now">
		<h2><span class="pulse" aria-hidden="true"></span>Şu sıralar</h2>
		<ul>
			{
				now.map(({ label, text, accent }, i) => (
					<li
						style={`--item: ${accent}; --reveal-delay: ${i * 90}ms`}
						data-reveal
					>
						<span class="now-label">{label}</span>
						<span class="now-text">{text}</span>
					</li>
				))
			}
		</ul>
	</section>

	<Work />

	<section class="featured" aria-label="Öne çıkanlar" data-reveal>
		<h2>Öne çıkanlar</h2>
		<div class="stage" id="stage">
			{
				featured.map((f, i) => (
					<a
						class={`fcard pos-${i}`}
						href={f.href}
						target="_blank"
						rel="noopener"
						style={`--item: ${f.accent}`}
						data-card
					>
						<span class="meta">
							<span class="kind">{f.kind}</span>
							{f.domain && (
								<span class="domain">
									{DOMAIN_LABELS[f.domain]}
								</span>
							)}
						</span>
						<h3>{f.title}</h3>
						<p>{f.text}</p>
					</a>
				))
			}
		</div>
	</section>

	<Timeline />
	<Events />

	<section class="stack" aria-label="Kullandığım teknolojiler" data-reveal>
		<div class="marquee">
			<ul class="marquee-track">
				{
					[0, 1].map((copy) => (
						<li aria-hidden={copy === 1}>
							{[
								"Swift",
								"SwiftUI",
								"SwiftData",
								"UIKit",
								"Python",
								"Unity",
								"C#",
								"TypeScript",
								"Astro",
								"FastAPI",
								"Git",
								"Firebase",
							].map((t) => (
								<span class="chip">{t}</span>
							))}
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		margin-bottom: var(--space-6);
	}
	.intro {
		font-size: 1.125rem;
		color: var(--text-muted);
		max-width: 38rem;
		min-height: 5.5em; /* scramble sırasında zıplamayı önler */
	}
	.cursor {
		color: var(--accent);
		animation: blink 1.2s steps(2) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.now h2 {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: 1.125rem;
		margin-bottom: var(--space-3);
	}
	.pulse {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--accent);
		animation: pulse 2.4s ease-out infinite;
	}
	@keyframes pulse {
		0% {
			box-shadow: 0 0 0 0 var(--accent-subtle);
		}
		70% {
			box-shadow: 0 0 0 12px transparent;
		}
		100% {
			box-shadow: 0 0 0 0 transparent;
		}
	}

	.now ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}
	.now li {
		display: flex;
		gap: var(--space-3);
		align-items: center;
		padding: var(--space-3);
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-radius: var(--radius);
		transition:
			border-color 0.25s var(--ease-spring),
			transform 0.25s var(--ease-spring),
			box-shadow 0.25s var(--ease-spring);
	}
	.now li:hover {
		border-color: color-mix(in srgb, var(--item) 45%, transparent);
		box-shadow: 0 0 28px color-mix(in srgb, var(--item) 16%, transparent);
		transform: translateX(4px);
	}
	.now-label {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--item);
		background: color-mix(in srgb, var(--item) 12%, transparent);
		border: 1px solid color-mix(in srgb, var(--item) 28%, transparent);
		padding: 3px 12px;
		border-radius: 999px;
		flex-shrink: 0;
	}
	.now-text {
		color: var(--text);
		font-size: 0.9375rem;
	}
	.updated {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
		margin-top: var(--space-3);
	}

	@media (prefers-reduced-motion: reduce) {
		.pulse {
			animation: none;
		}
	}

	.stack {
		margin-top: var(--space-6);
	}
	.marquee {
		overflow: hidden;
		mask-image: linear-gradient(
			90deg,
			transparent,
			black 12%,
			black 88%,
			transparent
		);
		-webkit-mask-image: linear-gradient(
			90deg,
			transparent,
			black 12%,
			black 88%,
			transparent
		);
	}
	.marquee-track {
		display: flex;
		width: max-content;
		list-style: none;
		margin: 0;
		padding: 0;
		animation: scroll 32s linear infinite;
	}
	.marquee:hover .marquee-track {
		animation-play-state: paused;
	}
	.marquee-track li {
		display: flex;
		gap: var(--space-2);
		padding-right: var(--space-2);
	}
	.chip {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--text-muted);
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		padding: 6px 16px;
		border-radius: 999px;
		white-space: nowrap;
		transition:
			color 0.2s,
			border-color 0.2s;
	}
	.chip:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	@keyframes scroll {
		to {
			transform: translateX(-50%);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.marquee-track {
			animation: none;
			flex-wrap: wrap;
		}
	}

	.featured {
		margin-top: var(--space-6);
	}
	.featured h2 {
		font-size: 1.125rem;
		margin-bottom: var(--space-4);
	}
	.stage {
		position: relative;
		height: 15rem;
		perspective: 1200px;
	}
	.fcard {
		position: absolute;
		inset: 0;
		margin: auto;
		max-width: 26rem;
		height: fit-content;
		padding: var(--space-4);
		border-radius: var(--radius-lg);
		background: color-mix(in srgb, var(--bg) 78%, #ffffff 5%);
		border: 1px solid var(--card-border);
		color: var(--text);
		will-change: transform, opacity;
		transition:
			transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.7s ease,
			border-color 0.3s ease,
			box-shadow 0.3s ease;
	}
	.fcard .meta {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}
	.fcard .kind {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--item);
		background: color-mix(in srgb, var(--item) 12%, transparent);
		border: 1px solid color-mix(in srgb, var(--item) 28%, transparent);
		padding: 2px 10px;
		border-radius: 999px;
	}
	.fcard .domain {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--text-muted);
		letter-spacing: 0.02em;
	}
	.fcard h3 {
		font-size: 1.0625rem;
		margin: var(--space-2) 0;
	}
	.fcard p {
		font-size: 0.875rem;
		color: var(--text-muted);
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.pos-0 {
		transform: translateZ(0);
		z-index: 3;
		border-color: color-mix(in srgb, var(--item) 40%, transparent);
		box-shadow:
			0 18px 50px rgba(0, 0, 0, 0.45),
			0 0 34px color-mix(in srgb, var(--item) 12%, transparent);
	}
	.pos-1 {
		transform: translateX(-38%) translateZ(-160px) rotateY(14deg)
			scale(0.94);
		z-index: 2;
		opacity: 0.55;
	}
	.pos-2 {
		transform: translateX(38%) translateZ(-160px) rotateY(-14deg)
			scale(0.94);
		z-index: 1;
		opacity: 0.55;
	}
	@media (max-width: 640px) {
		.stage {
			height: 17rem;
		}
		.fcard {
			max-width: calc(100vw - 4rem);
		}
		.pos-1 {
			transform: translateY(-9%) translateZ(-150px) scale(0.92);
		}
		.pos-2 {
			transform: translateY(9%) translateZ(-150px) scale(0.92);
		}
	}
</style>

<script>
	const el = document.getElementById("intro");
	const reduced = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;

	if (el && !reduced) {
		const intro = el; // TS narrowing closure'lara taşınmaz; sabit referans çözümü
		const original = (intro.textContent ?? "").replace(/\s+/g, " ").trim();
		const glyphs = "!<>-_\\/[]{}=+*^?#010110";
		const rand = () => glyphs[Math.floor(Math.random() * glyphs.length)];

		// 1) Açılışta: şifre çözülme efekti
		let progress = 0;
		const step = Math.ceil(original.length / 55);
		intro.textContent = original
			.split("")
			.map((c) => (c === " " ? " " : rand()))
			.join("");

		const decode = setInterval(() => {
			progress += step;
			intro.textContent = original
				.split("")
				.map((c, i) => (c === " " || i < progress ? c : rand()))
				.join("");
			if (progress >= original.length) {
				clearInterval(decode);
				intro.textContent = original;
				startFlicker();
			}
		}, 28);

		// 2) Sonrasında: arada bir küçük bölgesel titreşim
		function startFlicker() {
			setInterval(() => {
				const start = Math.floor(
					Math.random() * (original.length - 10),
				);
				let ticks = 0;
				const flicker = setInterval(() => {
					intro.textContent = original
						.split("")
						.map((c, i) =>
							i >= start &&
							i < start + 7 &&
							c !== " " &&
							Math.random() < 0.6
								? rand()
								: c,
						)
						.join("");
					if (++ticks > 4) {
						clearInterval(flicker);
						intro.textContent = original;
					}
				}, 55);
			}, 5000);
		}
	}
</script>

<script>
	const stage = document.getElementById("stage");
	const cards = Array.from(document.querySelectorAll("[data-card]"));
	const reducedMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;

	if (stage && cards.length > 1 && !reducedMotion) {
		let offset = 0;
		const n = cards.length;

		const apply = () => {
			cards.forEach((card, i) => {
				card.className = card.className.replace(
					/pos-\d/,
					`pos-${(i - offset + n) % n}`,
				);
			});
		};

		let timer = setInterval(() => {
			offset = (offset + 1) % n;
			apply();
		}, 4500);

		// Hover'da dur — kullanıcı okuyorsa sahne bekler
		stage.addEventListener("mouseenter", () => clearInterval(timer));
		stage.addEventListener("mouseleave", () => {
			timer = setInterval(() => {
				offset = (offset + 1) % n;
				apply();
			}, 4500);
		});

		// Arkadaki karta tıklanınca: linke gitme, öne gel
		cards.forEach((card, i) => {
			card.addEventListener("click", (e) => {
				if (!card.classList.contains("pos-0")) {
					e.preventDefault();
					offset = i;
					apply();
				}
			});
		});
	}
</script>
