---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Caner Çakal">
	<h1>merhaba, ben caner<span class="cursor">_</span></h1>
	<p>
		iOS geliştiriyorum, yazıyorum ve public olarak build ediyorum. Bu site
		şu an inşa halinde — süreci
		<a href="https://github.com/CanerCakal/canercakal-dev">repo'dan</a> izleyebilirsin.
	</p>
</BaseLayout>

<style>
	.cursor {
		color: var(--accent);
		animation: blink 1.2s steps(2) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
</style>
