---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import me from "../assets/me.png";
import me2 from "../assets/me-2.png";
import me3 from "../assets/me-3.png";
import { socials as contacts, socialIcons as icons } from "../data/social";
---

<BaseLayout
	title="Hakkımda — Caner Çakal"
	description="Caner kimdir — kod, denge ve merak üzerine."
>
	<section class="about">
		<div class="crew bleed" aria-hidden="true" data-reveal>
			<div class="figure side" style="--item: var(--accent)">
				<Image
					src={me2}
					alt=""
					widths={[320, 560]}
					sizes="(max-width: 700px) 26vw, 17rem"
				/>
			</div>
			<div class="figure lead-figure" style="--item: var(--accent-2)">
				<Image
					src={me}
					alt="Caner Çakal"
					widths={[400, 700]}
					sizes="(max-width: 700px) 34vw, 21rem"
				/>
			</div>
			<div class="figure side" style="--item: var(--accent-3)">
				<Image
					src={me3}
					alt=""
					widths={[320, 560]}
					sizes="(max-width: 700px) 26vw, 17rem"
				/>
			</div>
		</div>

		<div class="content prose-width">
			<h1 data-reveal>Merhaba<span class="dot"></span></h1>

			<p class="opener" data-reveal style="--reveal-delay: 120ms">
				Ben Caner. Çocukluğumdan beri bilgisayarlar, telefonlar, düğmesi
				olan ne varsa hepsi ilgimi çekiyordu. Bu merakın bedeli,
				kurcalarken bozduğum sayısız bilgisayar oldu; kazancı ise bugün
				yaptığım iş.
			</p>
			<p>
				Asıl kıvılcım bir okul gezisinde çıktı: Okul gezisiyle
				gittiğimiz ODTÜ'yü gezerken oradaki gönüllülerin anlattıkları ve
				atölyeler, o güne kadar sadece kurcaladığım şeylerin bir meslek
				olabileceğini gösterdi. Lisede artık yönüm netti. İşin iç yüzüne
				dair neredeyse hiçbir şey bilmiyordum ama "ben bilgisayar
				mühendisi olacağım" diyordum. Çalışmalarımın karşılığını alıp
				bölümü kazandığımda, o gezideki çocuğun sözünü tutmuş oldum.
			</p>
			<p>
				Kod yazmadığım zamanlarda sporumu yapar, sosyal hayatıma devam
				ederim; kafa dağıtmak için arada oyunlara dalarım. Ama beni en
				çok heyecanlandıran şey yeni yerler görmektir. Gezerkende
				durduğum her yerde tadım yapmak. Damak zevkim belki seçicidir
				ama yemeye bayılırım.
			</p>
			<p>
				Düzenli bir insanım: masanın dağınıklığı gibi kodun dağınıklığı
				da beni aynı derecede rahatsız eder. Sessiz ortamlara bayılırım
				ama yeri geldiğinde gümbürtünün içinde kendimi bulabilirim.
				Bence hayat da tam olarak böyle yaşanmalı: Dengede...
			</p>

			<ul class="contact" data-reveal style="--reveal-delay: 200ms">
				{
					contacts.map((c) => (
						<li style={"--item: " + c.accent}>
							<span class="ic" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<path d={icons[c.icon]} />
								</svg>
							</span>
							<span class="meta">
								<span class="k">{c.label}</span>
								{c.href ? (
									<a
										href={c.href}
										target="_blank"
										rel="noopener"
									>
										{c.value}
									</a>
								) : (
									<span class="v">{c.value}</span>
								)}
							</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>

<style>
	.about {
		position: relative;
	}
	.crew {
		display: flex;
		align-items: flex-end;
		justify-content: center;
		gap: 0;
		margin-bottom: var(--space-6);
	}
	.figure {
		position: relative;
		width: 17rem;
		transition: transform 0.35s var(--ease-spring);
	}
	.figure.lead-figure {
		width: 21rem;
		z-index: 2;
		margin: 0 -3rem; /* yanlardakilerin üstüne hafif binsin */
	}
	.figure.side {
		z-index: 1;
		transform: translateY(0.75rem) scale(0.96);
		opacity: 0.92;
	}
	.figure.side:first-child {
		rotate: -2.5deg;
	}
	.figure.side:last-child {
		rotate: 2.5deg;
	}
	.figure:hover {
		transform: translateY(-0.4rem);
		z-index: 3;
		opacity: 1;
	}
	.figure img {
		width: 100%;
		height: auto;
		display: block;
		filter: saturate(0.95) brightness(0.96);
		mask-image: linear-gradient(to bottom, black 78%, transparent 98%);
		-webkit-mask-image: linear-gradient(
			to bottom,
			black 78%,
			transparent 98%
		);
	}
	.figure::before {
		content: "";
		position: absolute;
		inset: 4% -8% -8% -8%;
		z-index: -1;
		background: radial-gradient(
			circle at 50% 42%,
			color-mix(in srgb, var(--item) 15%, transparent),
			transparent 68%
		);
		filter: blur(28px);
	}

	@media (max-width: 700px) {
		.figure {
			width: 26vw;
		}
		.figure.lead-figure {
			width: 34vw;
			margin: 0 -3vw;
		}
	}
	.content {
		position: relative;
		z-index: 1;
		margin-inline: auto;
	}
	.content h1 {
		text-align: center;
		margin-bottom: var(--space-4);
	}
	.dot {
		color: var(--accent);
	}
	.content p {
		color: var(--text-muted);
		line-height: 1.85;
		margin: 0 0 var(--space-4);
	}
	.content .opener {
		color: var(--text);
		font-size: 1.1875rem;
		line-height: 1.7;
		margin-bottom: var(--space-4);
	}
	.content em {
		color: var(--accent);
		font-style: normal;
	}

	.contact {
		list-style: none;
		margin: var(--space-6) 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-2);
		margin: var(--space-6) auto 0;
	}
	.contact li {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-3);
		background: var(--surface);
		border: 1px solid var(--card-border);
		box-shadow: var(--shadow-sm);
		border-radius: var(--radius);
		transition:
			border-color var(--t-base) var(--ease-out),
			box-shadow var(--t-base) var(--ease-out),
			transform var(--t-base) var(--ease-spring);
	}
	.contact li:hover {
		border-color: color-mix(in srgb, var(--item) 38%, transparent);
		box-shadow: var(--shadow-md);
		transform: translateY(-2px);
	}
	.ic {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		flex-shrink: 0;
		border-radius: var(--radius-sm);
		background: color-mix(in srgb, var(--item) 10%, transparent);
		border: 1px solid color-mix(in srgb, var(--item) 20%, transparent);
	}
	.ic svg {
		width: 17px;
		height: 17px;
		fill: var(--item);
	}
	.meta {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.k {
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.meta a,
	.v {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--text);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.meta a:hover {
		color: var(--item);
		opacity: 1;
	}

	@media (max-width: 640px) {
		.contact {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 820px) {
		.content.prose-width {
			max-width: none;
		}
	}
</style>