---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Caner Çakal — iOS Developer & Technical Writer",
} = Astro.props;

const nav = [
    { path: "/projects", label: "Projeler" },
    { path: "/writing", label: "Yazılar" },
    { path: "/about", label: "Hakkımda" },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="tr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>

        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta name="theme-color" content="#0a0b16" />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta
            property="og:url"
            content={new URL(Astro.url.pathname, Astro.site)}
        />
        <meta property="og:image" content={new URL("/og.png", Astro.site)} />
        <meta property="og:locale" content="tr_TR" />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={new URL("/og.png", Astro.site)} />
    </head>
    <body>
        <div class="aurora" aria-hidden="true">
            <span></span><span></span><span></span>
        </div>
        <div class="lens" id="lens" aria-hidden="true"></div>
        <header class="site-header">
            <nav>
                <a href="/" class="logo">Caner ÇAKAL</a>
                <ul>
                    {
                        nav.map(({ path, label }) => (
                            <li>
                                <a
                                    href={path}
                                    class:list={{
                                        active: currentPath.startsWith(path),
                                    }}
                                >
                                    {label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
        </header>

        <main>
            <slot />
        </main>

        <footer class="site-footer">
            <span class="prompt">$ echo</span> built in public — <a
                href="https://github.com/CanerCakal/canercakal-dev"
                target="_blank"
                rel="noopener">source</a
            >
        </footer>
    </body>
</html>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: color-mix(in srgb, var(--bg) 62%, transparent);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--border);
    }
    .site-header nav {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: var(--space-3);
    }
    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
    }
    .logo {
        font-family: var(--font-mono);
        font-weight: 600;
        color: var(--text);
    }
    nav ul {
        display: flex;
        gap: var(--space-3);
        list-style: none;
        margin: 0;
        padding: 0;
    }
    nav ul a {
        font-family: var(--font-mono);
        font-size: 0.875rem;
        color: var(--text-muted);
    }
    nav ul a.active,
    nav ul a:hover {
        color: var(--accent);
        opacity: 1;
    }

    main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: var(--space-5) var(--space-3);
        min-height: 60vh;
    }

    .site-footer {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: var(--space-4) var(--space-3);
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--text-muted);
        border-top: 1px solid var(--border);
    }
    .prompt {
        color: var(--accent);
    }
    .lens {
        position: fixed;
        top: 0;
        left: 0;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        pointer-events: none;
        z-index: 9999;
        transform: translate(-100px, -100px);
        border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
        background: radial-gradient(
            circle,
            color-mix(in srgb, var(--accent) 10%, transparent),
            transparent 70%
        );
        backdrop-filter: blur(2.5px) saturate(1.3);
        -webkit-backdrop-filter: blur(2.5px) saturate(1.3);
        transition:
            width 0.3s var(--ease-spring),
            height 0.3s var(--ease-spring),
            border-color 0.3s ease,
            opacity 0.3s ease;
        opacity: 0;
    }
    body:hover .lens {
        opacity: 1;
    }
    .lens.on-link {
        width: 64px;
        height: 64px;
        border-color: color-mix(in srgb, var(--accent-3) 55%, transparent);
        backdrop-filter: blur(1px) saturate(1.6);
        -webkit-backdrop-filter: blur(1px) saturate(1.6);
    }
    @media (pointer: coarse), (prefers-reduced-motion: reduce) {
        .lens {
            display: none;
        }
    }
</style>

<script>
    const lens = document.getElementById("lens");
    const fine = window.matchMedia("(pointer: fine)").matches;
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (lens && fine && !calm) {
        let targetX = -100,
            targetY = -100;
        let x = targetX,
            y = targetY;

        window.addEventListener(
            "mousemove",
            (e) => {
                targetX = e.clientX;
                targetY = e.clientY;
            },
            { passive: true },
        );

        const loop = () => {
            // lerp: her karede aradaki mesafenin %18'i kadar yaklaş — yumuşak takip
            x += (targetX - x) * 0.18;
            y += (targetY - y) * 0.18;
            lens.style.transform =
                "translate(" +
                (x - lens.offsetWidth / 2) +
                "px, " +
                (y - lens.offsetHeight / 2) +
                "px)";
            requestAnimationFrame(loop);
        };
        requestAnimationFrame(loop);

        document.addEventListener("mouseover", (e) => {
            const t = e.target;
            if (t instanceof Element) {
                lens.classList.toggle("on-link", !!t.closest("a, button"));
            }
        });
    }
</script>
